{
  "name": "github-repo-scan",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "security:secrets": "node scripts/check-secrets.mjs",
    "test": "node --test test/*.test.mjs && vitest run",
    "check": "npm run docs:check && npm run config:check && npm run security:secrets && npm run typecheck && npm test && npm audit --audit-level=high && npm run deploy:dry",
    "radar": "node --import tsx scripts/radar.ts",
    "schema:generate": "node scripts/generate-schema.mjs",
    "config:check": "node --import tsx scripts/check-config.ts",
    "typecheck": "wrangler types --env-file .env.example --check && tsc --noEmit",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "deploy:dry": "node --import tsx scripts/deploy.ts --dry-run",
    "deploy": "node --import tsx scripts/deploy.ts",
    "dev": "wrangler dev --test-scheduled",
    "docs:check": "node scripts/check-docs.mjs",
    "migrate:remote": "node --import tsx scripts/migrate.ts"
  },
  "dependencies": {
    "@dustwave/digest-core": "file:shared/dust-wave-platform/packages/digest-core",
    "@dustwave/worker-core": "file:shared/dust-wave-platform/packages/worker-core",
    "ajv": "8.20.0",
    "fflate": "0.8.3",
    "jsonc-parser": "3.3.1"
  },
  "devDependencies": {
    "@types/node": "26.5.0",
    "@vitest/coverage-v8": "4.1.11",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "wrangler": "4.129.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260907.1": true
  }
}
